+
+base::DictValue AppearanceHandler::ArciumAppearanceSnapshot() {
+  auto* model = arcium_appearance_.get();
+  if (!model || !model->available())
+    return base::DictValue().Set("available", false);
+  auto* space = model->GetAppearanceSpace();
+  base::ListValue spaces;
+  for (const auto& item : model->GetSpaces()) {
+    spaces.Append(base::DictValue()
+                      .Set("id", item.id)
+                      .Set("name", base::UTF16ToUTF8(item.name)));
+  }
+  base::DictValue preferences;
+  for (const auto& item : kWorkspacePreferences) {
+    base::Value value = item.boolean
+                            ? base::Value(model->GetBoolean(item.pref))
+                            : base::Value(model->GetInteger(item.pref));
+    preferences.Set(item.id,
+                    base::DictValue()
+                        .Set("value", std::move(value))
+                        .Set("editable", model->HasPreference(item.pref) &&
+                                             !model->IsManaged(item.pref)));
+  }
+  preferences.Set("sidebarWidth",
+                  base::DictValue()
+                      .Set("value", model->GetSidebarWidth())
+                      .Set("editable", model->HasSidebarWidth() &&
+                                           !model->IsSidebarWidthManaged()));
+  auto* browser = webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  auto* view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  const auto glass = helium::GetNativeFrameGlassAvailability();
+  const bool glass_active =
+      view && helium::ShouldUseNativeFrameGlass(view) &&
+      helium::GetNativeFrameGlassResolution(view).uses_translucent_native_base;
+  return base::DictValue()
+      .Set("windowGlassActive", glass_active)
+      .Set("windowGlassSupported",
+           glass.native_material && !glass.reduce_transparency)
+      .Set("available", space && !model->IsAppearanceManaged())
+      .Set("spaceId", space ? space->id() : std::string())
+      .Set("name", space ? base::UTF16ToUTF8(space->name()) : std::string())
+      .Set("spaces", std::move(spaces))
+      .Set("preferences", std::move(preferences))
+      .Set("chrome", model->GetChromeAppearance())
+      .Set("palette", model->GetSpacePalette())
+      .Set("mode", model->GetAppearanceMode())
+      .Set("webMode", model->GetWebAppearanceMode())
+      .Set("surface", model->GetSurfaceSet())
+      .Set("tuning", model->GetSurfaceTuning())
+      .Set("frame", model->GetContentFrame());
+}
+
+void AppearanceHandler::SetArciumAppearance(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 2u);
+  AllowJavascript();
+  const auto* request = args[1].GetIfDict();
+  const bool accepted = request && ApplyArciumAppearance(*request);
+  ResolveJavascriptCallback(args[0], base::Value(accepted));
+  if (accepted)
+    OnArciumAppearanceChanged();
+}
+
+bool AppearanceHandler::ApplyArciumAppearance(const base::DictValue& request) {
+  auto* model = arcium_appearance_.get();
+  const auto* target = request.FindString("spaceId");
+  const auto* action = request.FindString("action");
+  if (!model || !model->available() || !model->GetAppearanceSpace() ||
+      !target || *target != model->GetAppearanceSpace()->id() || !action)
+    return false;
+  const auto* value = request.Find("value");
+  if (!value)
+    return false;
+  if (*action == "space") {
+    return value->is_string() && model->SetAppearanceSpace(value->GetString());
+  }
+  if (*action == "mode" || *action == "webMode") {
+    if (!value->is_int())
+      return false;
+    return *action == "mode" ? model->SetAppearanceMode(value->GetInt())
+                             : model->SetWebAppearanceMode(value->GetInt());
+  }
+  if (*action == "resetPalette") {
+    if (model->IsAppearanceManaged() ||
+        model->IsManaged(helium::kHeliumSpacesPref))
+      return false;
+    model->ResetChromeAppearance();
+    return true;
+  }
+  if (*action == "surface") {
+    return value->is_string() && model->SetSurfaceSet(value->GetString());
+  }
+  if (*action == "chrome" || *action == "tuning" || *action == "frame") {
+    if (!value->is_dict())
+      return false;
+    auto merged = *action == "chrome"   ? model->GetChromeAppearance()
+                  : *action == "tuning" ? model->GetSurfaceTuning()
+                                        : model->GetContentFrame();
+    merged.Merge(value->GetDict().Clone());
+    return *action == "chrome"   ? model->SetChromeAppearance(merged)
+           : *action == "tuning" ? model->SetSurfaceTuning(merged)
+                                 : model->SetContentFrame(merged);
+  }
+  if (*action == "chroma") {
+    return value->is_dict() && model->SetSpacePaletteChroma(value->GetDict());
+  }
+  if (*action == "pref") {
+    if (!value->is_dict())
+      return false;
+    const auto* name = value->GetDict().FindString("name");
+    const auto* setting = value->GetDict().Find("value");
+    if (!name || !setting)
+      return false;
+    if (*name == "sidebarWidth") {
+      return setting->is_int() && model->SetSidebarWidth(setting->GetInt());
+    }
+    for (const auto& item : kWorkspacePreferences) {
+      if (*name != item.id)
+        continue;
+      if (!model->HasPreference(item.pref) || model->IsManaged(item.pref))
+        return false;
+      if (item.boolean) {
+        if (!setting->is_bool())
+          return false;
+        model->SetBoolean(item.pref, setting->GetBool());
+      } else {
+        if (!setting->is_int() || setting->GetInt() < item.minimum ||
+            setting->GetInt() > item.maximum)
+          return false;
+        model->SetInteger(item.pref, setting->GetInt());
+      }
+      return true;
+    }
+  }
+  if (*action == "preset") {
+    // Check every setting before the first write. Saved tabs and palettes are
+    // deliberately absent; this action changes only the visible layout.
+    const char* names[] = {prefs::kHeliumLayout,
+                           prefs::kHeliumVerticalRightAligned,
+                           prefs::kHeliumZenMode,
+                           prefs::kHeliumRoundedFrame,
+                           arcium::kArcSidebarNavigationEnabledPref,
+                           arcium::kChromeFrameBorderWidthPref,
+                           arcium::kChromeUIScalePref,
+                           arcium::kCollapsedSidebarStylePref,
+                           prefs::kVerticalTabsUncollapsedWidth};
+    for (const char* pref : names) {
+      if (!model->HasPreference(pref) || model->IsManaged(pref))
+        return false;
+    }
+    model->SetInteger(prefs::kHeliumLayout, 2);
+    model->SetBoolean(prefs::kHeliumVerticalRightAligned, false);
+    model->SetBoolean(prefs::kHeliumZenMode, false);
+    model->SetBoolean(prefs::kHeliumRoundedFrame, true);
+    model->SetBoolean(arcium::kArcSidebarNavigationEnabledPref, true);
+    model->SetInteger(arcium::kChromeFrameBorderWidthPref, 5);
+    model->SetInteger(arcium::kChromeUIScalePref, 110);
+    model->SetInteger(arcium::kCollapsedSidebarStylePref, 1);
+    return model->SetSidebarWidth(220);
+  }
+  return false;
+}
