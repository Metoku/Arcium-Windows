+void BrowserDesktopWindowTreeHostWin::UpdateArciumBackdrop() {
+  if (!arcium_widget_ready_ || !browser_view_ || !GetHWND() || !GetWidget() ||
+      !browser_view_->GetProfile())
+    return;
+  const auto availability = helium::GetNativeFrameGlassAvailability();
+  if (!availability.native_material) {
+    helium::SetWindowsFrameGlassReady(browser_view_, false);
+    return;
+  }
+  const auto resolution = helium::GetNativeFrameGlassResolution(browser_view_);
+  const bool composition_surface = (GetWindowLongPtr(GetHWND(), GWL_EXSTYLE) &
+                                    WS_EX_NOREDIRECTIONBITMAP) != 0;
+  const bool eligible =
+      composition_surface && browser_view_->GetIsNormalType() &&
+      !browser_view_->GetProfile()->IsOffTheRecord() &&
+      !browser_view_->GetProfile()->IsGuestSession() &&
+      !ThemeServiceFactory::GetForProfile(browser_view_->GetProfile())
+           ->UsingPolicyTheme() &&
+      resolution.enabled && resolution.paints_chrome_transparent;
+  const bool frosted = eligible && resolution.uses_translucent_native_base;
+  const auto configuration = helium::ReadGlassSurfaceConfiguration(
+      browser_view_->GetProfile()->GetPrefs());
+  const DWM_SYSTEMBACKDROP_TYPE backdrop =
+      !frosted ? DWMSBT_NONE
+      : configuration.material == helium::GlassSurfaceMaterial::kAuto
+          ? DWMSBT_MAINWINDOW
+          : DWMSBT_TRANSIENTWINDOW;
+  const HRESULT installed = DwmSetWindowAttribute(
+      GetHWND(), DWMWA_SYSTEMBACKDROP_TYPE, &backdrop, sizeof(backdrop));
+  const MARGINS margins = frosted && SUCCEEDED(installed)
+                              ? MARGINS{-1, -1, -1, -1}
+                              : MARGINS{0, 0, 0, 0};
+  const HRESULT extended = DwmExtendFrameIntoClientArea(GetHWND(), &margins);
+  const BOOL dark =
+      GetWidget()->GetColorMode() == ui::ColorProviderKey::ColorMode::kDark;
+  DwmSetWindowAttribute(GetHWND(), DWMWA_USE_IMMERSIVE_DARK_MODE, &dark,
+                        sizeof(dark));
+  helium::SetWindowsFrameGlassReady(
+      browser_view_, eligible && SUCCEEDED(installed) && SUCCEEDED(extended));
 }
 
