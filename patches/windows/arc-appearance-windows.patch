+void AppearanceHandler::GetArciumAppearance(const base::ListValue& args) {
+  CHECK_EQ(args.size(), 1u);
+  AllowJavascript();
+  if (!arcium_appearance_ || !arcium_appearance_->GetAppearanceSpace()) {
+    arcium_appearance_.reset();
+    arcium_appearance_ =
+        arcium_settings::ArciumSettingsModel::CaptureForWebContents(
+            web_ui()->GetWebContents(),
+            base::BindRepeating(&AppearanceHandler::OnArciumAppearanceChanged,
+                                weak_ptr_factory_.GetWeakPtr()),
+            base::DoNothing());
+  }
+  ResolveJavascriptCallback(args[0], base::Value(ArciumAppearanceSnapshot()));
