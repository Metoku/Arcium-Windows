 .indented-toggles settings-toggle-button {
   padding-inline-start: 0;
 }
+
+.workspace-description {
+  color: var(--cr-secondary-text-color);
+  padding: 0 20px;
+}
+
+fieldset {
+  border: 0;
+  margin: 0;
+  min-width: 0;
+  padding: 0;
+}
+
+.workspace-row {
+  align-items: center;
+  border-top: var(--cr-separator-line);
+  display: flex;
+  gap: 20px;
+  justify-content: space-between;
+  min-height: 48px;
+  padding: 8px 20px;
+}
+
+.workspace-row > span {
+  flex: 1;
+}
+
+.workspace-row select {
+  max-width: 55%;
+}
+
+.workspace-row input[type=number] {
+  width: 80px;
+}
+
+.workspace-row input[type=range] {
+  max-width: 45%;
+  width: 160px;
+}
+
+.workspace-glow {
+  border-top: var(--cr-separator-line);
+  padding: 12px 20px;
+}
+
+.workspace-glow summary {
+  cursor: pointer;
+}
+
+button,
+select,
+input[type=number] {
+  background: var(--cr-card-background-color);
+  border: 1px solid var(--cr-separator-color);
+  border-radius: 6px;
+  color: var(--cr-primary-text-color);
+  font: inherit;
+  padding: 8px;
+}
+
+button {
+  cursor: pointer;
+}
+
+button:focus-visible,
+select:focus-visible,
+input:focus-visible {
+  outline: 2px solid var(--cr-focus-outline-color);
+}
