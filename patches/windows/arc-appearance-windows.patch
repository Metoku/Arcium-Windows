+void CustomizeChromePageHandler::ClosePanel() {
+#if !BUILDFLAG(IS_ANDROID)
+  if (auto* browser = webui::GetBrowserWindowInterface(web_contents_)) {
+    if (auto* panel = SidePanelCoordinator::From(browser);
+        panel &&
+        panel->GetCurrentEntryId() == SidePanelEntryId::kCustomizeChrome) {
+      panel->Close();
+    }
+  }
+#endif
+}
+
+void CustomizeChromePageHandler::OpenWorkspaceAppearance() {
+#if !BUILDFLAG(IS_ANDROID)
+  auto* browser = webui::GetBrowserWindowInterface(web_contents_);
+  if (!browser || browser->GetProfile() != profile_)
+    return;
+  NavigateParams params(browser, GURL("chrome://settings/appearance"),
+                        ui::PAGE_TRANSITION_LINK);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  Navigate(&params);
+  // Navigation may destroy the source WebUI; use only the captured browser.
+  if (auto* panel = SidePanelCoordinator::From(browser);
+      panel &&
+      panel->GetCurrentEntryId() == SidePanelEntryId::kCustomizeChrome) {
+    panel->Close();
+  }
+#endif
+}
