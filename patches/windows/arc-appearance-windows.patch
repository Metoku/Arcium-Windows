+std::unique_ptr<ArciumSettingsModel> ArciumSettingsModel::CaptureForWebContents(
+    content::WebContents* contents,
+    base::RepeatingClosure changed_callback,
+    base::RepeatingClosure profile_destroyed_callback) {
+  if (!contents)
+    return nullptr;
+  auto* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  auto* browser = webui::GetBrowserWindowInterface(contents);
+  if (!profile || profile->IsOffTheRecord() || profile->IsGuestSession() ||
+      !browser || browser->GetProfile() != profile ||
+      !browser->GetIsNormalType()) {
+    return nullptr;
+  }
+  auto* service = helium::HeliumSpaceServiceFactory::GetForProfile(profile);
+  if (!service)
+    return nullptr;
+  const std::string id(service->GetExplicitSpaceIdForBrowser(browser));
+  if (id.empty() || !service->GetSpaceById(id))
+    return nullptr;
+  auto model = std::make_unique<ArciumSettingsModel>(
+      profile, std::move(changed_callback),
+      std::move(profile_destroyed_callback));
+  if (!model->SetAppearanceSpace(id))
+    return nullptr;
+  return model;
+}
