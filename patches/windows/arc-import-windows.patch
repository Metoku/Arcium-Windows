+TEST(ArcSidebarSnapshotTest, WindowsConflictingIdsAndCollectionsFailClosed) {
+  auto root = ParseWindowsFixture();
+  ASSERT_TRUE(root);
+  auto& data =
+      (*root->FindDict("sidebar")->FindList("containers"))[1].GetDict();
+  auto duplicate = data.FindList("items")->front().Clone();
+  duplicate.GetDict().Set("title", "conflicting root");
+  data.FindList("items")->Append(std::move(duplicate));
+  EXPECT_FALSE(ParseArcSidebarSnapshot(*root, "Default"));
+  root = ParseWindowsFixture();
+  auto& containers = *root->FindDict("sidebar")->FindList("containers");
+  auto second = containers[1].Clone();
+  second.GetDict().Set("topAppsContainerIDs", base::ListValue());
+  containers.Append(std::move(second));
+  EXPECT_FALSE(ParseArcSidebarSnapshot(*root, "Default"));
+}
