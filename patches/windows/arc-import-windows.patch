+TEST(ArcSidebarSnapshotTest, WindowsRecordsPreserveFoldersFavoritesAndOrder) {
+  auto root = ParseWindowsFixture();
+  ASSERT_TRUE(root);
+  const auto before = root->Clone();
+  auto snapshot = ParseArcSidebarSnapshot(*root, "Default");
+  ASSERT_TRUE(snapshot);
+  EXPECT_EQ(*root, before);  // The source is always read-only.
+  ASSERT_EQ(snapshot->spaces.size(), 1u);
+  EXPECT_EQ(snapshot->spaces[0].name, "Windows Work");
+  const auto& pins = snapshot->spaces[0].pins;
+  ASSERT_EQ(pins.size(), 4u);
+  EXPECT_EQ(pins[0].type, ArcSidebarNode::Type::kFolder);
+  EXPECT_EQ(pins[0].title, "Research");
+  EXPECT_TRUE(pins[0].collapsed);
+  ASSERT_EQ(pins[0].children.size(), 1u);
+  ASSERT_EQ(pins[0].children[0].children.size(), 1u);
+  EXPECT_EQ(pins[0].children[0].children[0].url, "https://saved.example/");
+  EXPECT_EQ(pins[1].title, "Empty folder");
+  EXPECT_TRUE(pins[1].children.empty());
+  EXPECT_EQ(pins[2].url, "https://left.example/");
+  EXPECT_EQ(pins[3].url, "https://right.example/");
+  ASSERT_EQ(snapshot->favorites.size(), 1u);
+  EXPECT_EQ(snapshot->favorites[0].url, "https://favorite.example/");
+  const auto other = ParseArcSidebarSnapshot(*root, "Profile 1");
+  ASSERT_TRUE(other);
+  EXPECT_TRUE(other->spaces.empty());
+  EXPECT_TRUE(other->favorites.empty());
+}
