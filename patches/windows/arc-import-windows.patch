+// Windows Arc snapshots can store named records as objects with explicit IDs
+// and use Swift's enum-key encoding for section IDs. Canonicalize those forms
+// before the existing profile-scoped parser runs. Never infer a profile from
+// a display name or merge two conflicting records.
+std::optional<base::DictValue> NormalizeSidebarData(
+    const base::DictValue& original) {
+  base::DictValue data = original.Clone();
+  for (const char* key : {"items", "spaces"}) {
+    const auto* values = data.FindList(key);
+    if (!values || values->empty() || values->front().is_string())
+      continue;
+    base::ListValue normalized;
+    std::map<std::string, const base::DictValue*> seen;
+    for (const auto& value : *values) {
+      const auto* record = value.GetIfDict();
+      const auto* id = record ? record->FindString("id") : nullptr;
+      if (!id || id->empty())
+        return std::nullopt;
+      auto [previous, inserted] = seen.emplace(*id, record);
+      if (!inserted) {
+        if (*previous->second != *record)
+          return std::nullopt;
+        continue;
+      }
+      normalized.Append(*id);
+      normalized.Append(record->Clone());
+    }
+    data.Set(key, std::move(normalized));
+  }
+  if (auto* spaces = data.FindList("spaces")) {
+    for (size_t i = 0; i + 1 < spaces->size(); i += 2) {
+      auto* space = (*spaces)[i + 1].GetIfDict();
+      if (!space)
+        continue;
+      const auto* newer = space->FindList("newContainerIDs");
+      if (!newer)
+        continue;
+      if (newer->size() % 2u != 0u)
+        return std::nullopt;
+      base::ListValue converted;
+      for (size_t j = 0; j < newer->size(); j += 2) {
+        const auto* kind = (*newer)[j].GetIfDict();
+        const auto* id = (*newer)[j + 1].GetIfString();
+        if (!kind || kind->size() != 1u || !id || id->empty())
+          return std::nullopt;
+        if (kind->contains("pinned"))
+          converted.Append("pinned");
+        else if (kind->contains("unpinned"))
+          converted.Append("unpinned");
+        else
+          return std::nullopt;
+        converted.Append(*id);
+      }
+      if (const auto* older = space->FindList("containerIDs");
+          older && *older != converted)
+        return std::nullopt;
+      space->Set("containerIDs", std::move(converted));
+    }
+  }
+  // An explicit childrenIds list, including an empty one, is authoritative.
+  // Older Windows records omit it; retain their parent-linked array order.
+  if (auto* items = data.FindList("items")) {
+    std::map<std::string, std::vector<std::string>> children;
+    for (size_t i = 0; i + 1 < items->size(); i += 2) {
+      const auto* id = (*items)[i].GetIfString();
+      const auto* item = (*items)[i + 1].GetIfDict();
+      const auto* parent = item ? item->FindString("parentID") : nullptr;
+      if (id && parent && !parent->empty())
+        children[*parent].push_back(*id);
+    }
+    for (size_t i = 0; i + 1 < items->size(); i += 2) {
+      const auto* id = (*items)[i].GetIfString();
+      auto* item = (*items)[i + 1].GetIfDict();
+      if (!id || !item || item->contains("childrenIds"))
+        continue;
+      const auto found = children.find(*id);
+      if (found == children.end())
+        continue;
+      base::ListValue ordered;
+      for (const auto& child : found->second)
+        ordered.Append(child);
+      item->Set("childrenIds", std::move(ordered));
+    }
+  }
+  return data;
+}
+
+bool IsDefaultProfile(const base::DictValue* profile) {
+  const auto* value = profile ? profile->Find("default") : nullptr;
+  return value && ((value->is_bool() && value->GetBool()) ||
+                   (value->is_dict() && value->GetDict().empty()));
+}
 
