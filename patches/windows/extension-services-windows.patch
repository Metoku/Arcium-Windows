+
+function servicesFlow(search, prefs) {
+    const context = vm.createContext({exports: {}, URLSearchParams, SvelteSet: Set,
+        writable: stores.writable, derived: stores.derived, get: stores.get,
+        platform: {is: {android: false}}, location: {search},
+        preferences: stores.writable(prefs), importableProfiles: stores.writable([]),
+        canBeDefaultBrowser: true, isDefaultBrowser: stores.writable(false),
+    });
+    vm.runInContext(transpile(readFileSync('src/lib/onboarding-flow.ts', 'utf8'), true), context);
+    return context.exports;
+}
+
+test('services review opens directly for fresh, completed and loading profiles and cannot walk into imports', () => {
+    for (const prefs of [{}, {completed_onboarding: true}, {completed_onboarding: false}]) {
+        const before = {...prefs};
+        const flow = servicesFlow('?services=1', prefs);
+        assert.equal(flow.standaloneServices, true);
+        assert.equal(flow.standaloneImport, false);
+        for (const action of [() => {}, flow.nextPage, flow.previousPage,
+            () => flow.chooseRoute('arcCustom'), () => flow.chooseRoute('other')]) {
+            action();
+            assert.equal(stores.get(flow.currentPage), 'HeliumServices');
+        }
+        assert.deepEqual(prefs, before, 'opening and navigating never change native prefs');
+    }
+});
+
+test('Arc import entry takes precedence and unrelated setup URLs retain the Welcome route', () => {
+    for (const search of ['?services=1&import=arc', '?import=arc&services=1']) {
+        const flow = servicesFlow(search, {completed_onboarding: true});
+        assert.equal(flow.standaloneServices, false);
+        assert.equal(flow.standaloneImport, true);
+        assert.equal(stores.get(flow.currentPage), 'ArcSpaces');
+    }
+    for (const search of ['', '?services=0', '?services=true', '?import=other']) {
+        const flow = servicesFlow(search, {completed_onboarding: true});
+        assert.equal(flow.standaloneServices, false);
+        assert.equal(stores.get(flow.currentPage), 'Welcome');
+    }
+});
+
+function serviceNavigation(extra = {}) {
+    const calls = [];
+    const n = navigation(null, {$currentPage: 'HeliumServices', standaloneServices: true,
+        setPref: async (...args) => calls.push(['pref', ...args]),
+        acceptLatestSchema: () => calls.push(['schema']),
+        window: {open: (...args) => calls.push(['navigate', ...args])},
+        importProfile: () => assert.fail('services review must not import'),
+        askToBeDefault: () => assert.fail('services review must not change the default browser'),
+        ...extra,
+    });
+    return {...n, calls};
+}
+
+test('opening and leaving services review never grant consent or complete onboarding', () => {
+    const n = serviceNavigation();
+    assert.deepEqual(n.calls, [], 'merely opening review has no writes or navigation');
+    n.back();
+    assert.deepEqual(n.calls, [['navigate', 'chrome://settings/privacy/services', '_self']]);
+    assert.equal(n.advances(), 0);
+});
+
+test('Next waits for persisted consent, deduplicates clicks, and returns to services without changing choices', async () => {
+    const prefs = {completed_onboarding: true, 'services.enabled': false,
+        'services.ext_proxy': false, 'services.user_consented': false};
+    let resolve;
+    const writes = [];
+    const n = serviceNavigation({setPref: (name, value) => {
+        writes.push([name, value]);
+        return new Promise(done => {resolve = () => {prefs[name] = value; done();};});
+    }});
+    const pending = n.next();
+    await n.next();
+    assert.deepEqual(writes, [['services.user_consented', true]]);
+    assert.deepEqual(n.calls, [], 'no navigation or schema acceptance before the native reply');
+    assert.equal(n.state().working, true);
+    resolve(); await pending;
+    assert.deepEqual(n.calls, [['schema'], ['navigate', 'chrome://settings/privacy/services', '_self']]);
+    assert.deepEqual(prefs, {completed_onboarding: true, 'services.enabled': false,
+        'services.ext_proxy': false, 'services.user_consented': true});
+    assert.equal(n.advances(), 0);
+    assert.equal(n.state().working, false);
+});
+
+test('failed consent write stays on review with a working retry', async () => {
+    let fail = true;
+    const writes = [];
+    const n = serviceNavigation({setPref: async (...args) => {
+        writes.push(args);
+        if (fail) throw new Error('native bridge failed');
+    }});
+    await n.next();
+    assert.deepEqual(n.calls, []);
+    assert.equal(n.advances(), 0);
+    assert.equal(n.state().stepFailed, true);
+    assert.equal(n.state().working, false);
+    fail = false; await n.next();
+    assert.deepEqual(writes, [['services.user_consented', true], ['services.user_consented', true]]);
+    assert.equal(n.state().stepFailed, false);
+    assert.deepEqual(n.calls, [['schema'], ['navigate', 'chrome://settings/privacy/services', '_self']]);
+});
+
+test('pending or failed preferences cannot grant consent; an authoritative reply unlocks review', async () => {
+    for (const state of ['pending', 'failed']) {
+        const n = serviceNavigation({$preferencesBootstrap: state});
+        await n.next();
+        assert.deepEqual(n.calls, []);
+        assert.equal(n.state().working, false);
+        n.context.$preferencesBootstrap = 'ready';
+        await n.next();
+        assert.deepEqual(n.calls[0], ['pref', 'services.user_consented', true]);
+        assert.deepEqual(n.calls.at(-1), ['navigate', 'chrome://settings/privacy/services', '_self']);
+    }
+});
+
+test('services controls and bootstrap retry compile with Svelte', () => {
+    compile(readFileSync('src/pages/HeliumServices.svelte', 'utf8'),
+        {filename: 'HeliumServices.svelte', generate: 'client'});
+});
