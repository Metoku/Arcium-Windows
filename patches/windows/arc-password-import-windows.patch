 namespace policy {
 namespace {
 
-// Keep credential saving disabled regardless of user or enterprise settings.
+// Keep built-in passkeys disabled. On Windows, local saved passwords follow
+// Chromium's normal user preferences and PasswordManagerEnabled policy.
 class DisabledPasswordManagerPolicyHandler : public ConfigurationPolicyHandler {
  public:
   bool CheckPolicySettings(const PolicyMap& policies,
                            PolicyErrorMap* errors) override {
     return true;
   }
 
   void ApplyPolicySettings(const PolicyMap& policies,
                            PrefValueMap* prefs) override {
+#if !BUILDFLAG(IS_WIN)
     prefs->SetBoolean(password_manager::prefs::kCredentialsEnableService,
                       false);
+#endif
     prefs->SetBoolean(password_manager::prefs::kCredentialsEnablePasskeys,
                       false);
   }
 };
 
