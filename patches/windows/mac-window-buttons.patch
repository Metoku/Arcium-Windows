+void WindowsCaptionButton::PaintMacSymbol(gfx::Canvas* canvas) {
+  SkColor color;
+  switch (button_type_) {
+    case VIEW_ID_CLOSE_BUTTON:
+      color = SkColorSetRGB(255, 95, 87);
+      break;
+    case VIEW_ID_MINIMIZE_BUTTON:
+      color = SkColorSetRGB(254, 188, 46);
+      break;
+    case VIEW_ID_MAXIMIZE_BUTTON:
+    case VIEW_ID_RESTORE_BUTTON:
+      color = SkColorSetRGB(40, 200, 64);
+      break;
+    default:
+      NOTREACHED();
+  }
+  if (!GetEnabled() || !GetWidget()->ShouldPaintAsActive()) {
+    color = SkColorSetRGB(150, 150, 150);
+  } else if (GetState() == STATE_PRESSED) {
+    color =
+        color_utils::GetResultingPaintColor(SkColorSetARGB(45, 0, 0, 0), color);
+  }
+
+  const auto middle = GetContentsBounds().CenterPoint();
+  const gfx::PointF center(middle.x(), middle.y());
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(color);
+  canvas->DrawCircle(center, 6.f, flags);
+  flags.setColor(SkColorSetARGB(56, 0, 0, 0));
+  flags.setStyle(cc::PaintFlags::kStroke_Style);
+  flags.setStrokeWidth(0.5f);
+  canvas->DrawCircle(center, 5.75f, flags);
+
+  if (!GetEnabled() ||
+      (GetState() != STATE_HOVERED && GetState() != STATE_PRESSED)) {
+    return;
+  }
+  flags.setColor(SkColorSetARGB(190, 0, 0, 0));
+  flags.setStrokeWidth(1.f);
+  const float x = center.x();
+  const float y = center.y();
+  if (button_type_ == VIEW_ID_CLOSE_BUTTON) {
+    canvas->DrawLine(gfx::PointF(x - 2.5f, y - 2.5f),
+                     gfx::PointF(x + 2.5f, y + 2.5f), flags);
+    canvas->DrawLine(gfx::PointF(x - 2.5f, y + 2.5f),
+                     gfx::PointF(x + 2.5f, y - 2.5f), flags);
+  } else if (button_type_ == VIEW_ID_RESTORE_BUTTON) {
+    canvas->DrawRect(gfx::RectF(x - 2.5f, y - 2.f, 5.f, 4.f), flags);
+  } else {
+    canvas->DrawLine(gfx::PointF(x - 3.f, y), gfx::PointF(x + 3.f, y), flags);
+    if (button_type_ == VIEW_ID_MAXIMIZE_BUTTON) {
+      canvas->DrawLine(gfx::PointF(x, y - 3.f), gfx::PointF(x, y + 3.f), flags);
+    }
+  }
+}
