+#if BUILDFLAG(IS_WIN)
+// Helium is an explicit import source, never Arcium's live profile directory.
+void DetectHeliumProfiles(
+    std::vector<user_data_importer::SourceProfile>* profiles) {
+  const base::FilePath helium_data = GetHeliumUserDataFolder();
+  if (helium_data.empty()) {
+    return;
+  }
+  std::vector<user_data_importer::SourceProfile> helium_profiles;
+  AddChromeToProfiles(
+      &helium_profiles,
+      GetChromeSourceProfiles(helium_data.AppendASCII("Local State")),
+      helium_data, "Helium", user_data_importer::TYPE_CHROME);
+  for (auto& profile : helium_profiles) {
+    // Extension installation and passwords need their own explicit flows.
+    profile.services_supported &=
+        user_data_importer::HISTORY | user_data_importer::FAVORITES;
+    if (profile.services_supported != user_data_importer::NONE) {
+      profiles->push_back(profile);
+    }
+  }
+}
+#endif
