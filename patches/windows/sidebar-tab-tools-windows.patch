+  METADATA_HEADER(ArciumSidebarTabToolsView, views::FlexLayoutView)
+
+ public:
+  ArciumSidebarTabToolsView(BrowserWindowInterface* browser,
+                            base::RepeatingClosure menu_will_show,
+                            base::RepeatingClosure menu_closed)
+      : browser_(browser->GetWeakPtr()),
+        menu_will_show_(std::move(menu_will_show)),
+        menu_closed_(std::move(menu_closed)),
+        menu_(this) {
+    SetOrientation(views::LayoutOrientation::kHorizontal);
+    SetMainAxisAlignment(views::LayoutAlignment::kEnd);
+    auto add_button = [this](int text, int tooltip,
+                             base::RepeatingClosure callback) {
+      auto button = std::make_unique<views::LabelButton>(
+          std::move(callback), l10n_util::GetStringUTF16(text));
+      button->SetTooltipText(l10n_util::GetStringUTF16(tooltip));
+      button->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(4, 5)));
+      button->SetTextColor(views::Button::STATE_NORMAL,
+                           ui::kColorLabelForegroundSecondary);
+      return AddChildView(std::move(button));
+    };
+    add_button(IDS_ARCIUM_TAB_TOOLS_TIDY, IDS_ARCIUM_TAB_TOOLS_TIDY_HELP,
+               base::BindRepeating(&ArciumSidebarTabToolsView::Tidy,
+                                   weak_factory_.GetWeakPtr()));
+    add_button(IDS_ARCIUM_TAB_TOOLS_CLEAR, IDS_ARCIUM_TAB_TOOLS_CLEAR_HELP,
+               base::BindRepeating(&ArciumSidebarTabToolsView::Clear,
+                                   weak_factory_.GetWeakPtr()));
+    menu_button_ =
+        add_button(IDS_ARCIUM_TAB_TOOLS_MENU, IDS_ARCIUM_TAB_TOOLS_MENU_HELP,
+                   base::BindRepeating(&ArciumSidebarTabToolsView::ShowMenu,
+                                       weak_factory_.GetWeakPtr()));
+    menu_button_->GetViewAccessibility().SetName(
+        l10n_util::GetStringUTF16(IDS_ARCIUM_TAB_TOOLS_MENU_HELP));
+
+    menu_.AddTitle(l10n_util::GetStringUTF16(IDS_ARCIUM_TAB_TOOLS_CLEANUP));
+    for (const auto& [hours, label] : kCleanupOptions) {
+      menu_.AddRadioItem(kCleanupBase + hours, l10n_util::GetStringUTF16(label),
+                         1);
+    }
+    menu_.AddSeparator(ui::NORMAL_SEPARATOR);
+    menu_.AddItem(kRestore,
+                  l10n_util::GetStringUTF16(IDS_ARCIUM_TAB_TOOLS_RESTORE));
+    menu_.AddItem(kRecentlyClosed,
+                  l10n_util::GetStringUTF16(IDS_ARCIUM_TAB_TOOLS_RECENT));
+
+    pref_registrar_.Init(browser->GetProfile()->GetPrefs());
+    pref_registrar_.Add(
+        arcium_settings::kTabCleanupHoursPref,
+        base::BindRepeating(&ArciumSidebarTabToolsView::UpdateCleanupTimer,
+                            weak_factory_.GetWeakPtr()));
+    UpdateCleanupTimer();
+  }
+  ~ArciumSidebarTabToolsView() override = default;
+
+ private:
+  using WeakTab = base::WeakPtr<tabs::TabInterface>;
+  static constexpr int kCleanupBase = 1000;
+  static constexpr int kRestore = 1;
+  static constexpr int kRecentlyClosed = 2;
+  static constexpr std::pair<int, int> kCleanupOptions[] = {
+      {0, IDS_ARCIUM_TAB_TOOLS_OFF},
+      {12, IDS_ARCIUM_TAB_TOOLS_12_HOURS},
+      {24, IDS_ARCIUM_TAB_TOOLS_24_HOURS},
+      {72, IDS_ARCIUM_TAB_TOOLS_3_DAYS},
+      {168, IDS_ARCIUM_TAB_TOOLS_7_DAYS}};
+
+  Browser* GetBrowser() const {
+    if (!browser_ ||
+        browser_->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+      return nullptr;
+    }
+    Browser* browser = browser_->GetBrowserForMigrationOnly();
+    return browser && !browser->IsAttemptingToCloseBrowser() ? browser
+                                                             : nullptr;
+  }
+
+  static std::string SpaceId(Browser* browser) {
+    auto* spaces =
+        helium::HeliumSpaceServiceFactory::GetForProfile(browser->profile());
+    return spaces ? std::string(spaces->GetSpaceIdForBrowser(browser))
+                  : std::string();
+  }
+
+  static bool IsDurable(tabs::TabInterface* tab, Browser* browser) {
+    auto* spaces =
+        helium::HeliumSpaceServiceFactory::GetForProfile(browser->profile());
+    // Without the durable-item service, fail closed rather than risk a Pin.
+    return !spaces || tab->IsPinned() || spaces->IsPersistentItemTab(tab);
+  }
+
+  static std::string TidySite(tabs::TabInterface* tab, Browser* browser) {
+    if (!tab || tab->GetBrowserWindowInterface() != browser || tab->IsSplit() ||
+        tab->GetGroup() || IsDurable(tab, browser)) {
+      return {};
+    }
+    const GURL url = tab->GetURL();
+    if (!url.SchemeIsHTTPOrHTTPS()) {
+      return {};
+    }
+    std::string site = net::registry_controlled_domains::GetDomainAndRegistry(
+        url, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+    return site.empty() ? url.host() : site;
+  }
+
+  void Tidy() {
+    Browser* browser = GetBrowser();
+    if (!browser || !browser->tab_strip_model()->SupportsTabGroups()) {
+      return;
+    }
+    const std::string space_id = SpaceId(browser);
+    auto self = weak_factory_.GetWeakPtr();
+    std::vector<WeakTab> tabs;
+    std::vector<std::string> sites;
+    for (auto* tab : *browser->tab_strip_model()) {
+      tabs.push_back(tab->GetWeakPtr());
+      sites.push_back(TidySite(tab, browser));
+    }
+    for (const auto& bucket : ArciumTidyBuckets(sites)) {
+      browser = GetBrowser();
+      if (!browser || SpaceId(browser) != space_id) {
+        return;
+      }
+      TabStripModel* model = browser->tab_strip_model();
+      if (!model->SupportsTabGroups()) {
+        return;
+      }
+      std::vector<int> indices;
+      const std::string& site = sites[bucket.front()];
+      for (int index : bucket) {
+        if (tabs[index] && TidySite(tabs[index].get(), browser) == site) {
+          const int current = model->GetIndexOfTab(tabs[index].get());
+          if (current != TabStripModel::kNoTab) {
+            indices.push_back(current);
+          }
+        }
+      }
+      std::sort(indices.begin(), indices.end());
+      if (indices.size() < 2) {
+        continue;
+      }
+      const auto group = model->AddToNewGroup(indices);
+      if (!self) {
+        return;
+      }
+      browser = GetBrowser();
+      if (!browser || SpaceId(browser) != space_id) {
+        return;
+      }
+      model = browser->tab_strip_model();
+      if (model->group_model() &&
+          model->group_model()->ContainsTabGroup(group)) {
+        model->ChangeTabGroupVisuals(
+            group,
+            tab_groups::TabGroupVisualData(base::UTF8ToUTF16(site),
+                                           tab_groups::TabGroupColorId::kGrey));
+        if (!self) {
+          return;
+        }
+      }
+    }
+  }
+
+  void Clear() {
+    if (GetBrowser() &&
+        chrome::IsCommandEnabled(browser_.get(), IDC_ARCIUM_CLEAR_UNPINNED)) {
+      chrome::ExecuteCommand(browser_.get(), IDC_ARCIUM_CLEAR_UNPINNED);
+    }
+  }
+
+  int CleanupHours() const {
+    Browser* browser = GetBrowser();
+    return browser && !browser->profile()->IsOffTheRecord()
+               ? ArciumCleanupHours(browser->profile()->GetPrefs()->GetInteger(
+                     arcium_settings::kTabCleanupHoursPref))
+               : 0;
+  }
+
+  void UpdateCleanupTimer() {
+    cleanup_timer_.Stop();
+    if (CleanupHours() > 0) {
+      // No immediate sweep when enabling, changing a duration or starting up.
+      cleanup_timer_.Start(
+          FROM_HERE, base::Minutes(5),
+          base::BindRepeating(&ArciumSidebarTabToolsView::Cleanup,
+                              weak_factory_.GetWeakPtr()));
+    }
+  }
+
+  static bool CanAutoClean(tabs::TabInterface* tab,
+                           Browser* browser,
+                           int hours) {
+    if (!tab || tab->GetBrowserWindowInterface() != browser ||
+        !performance_manager::PerformanceManager::IsAvailable()) {
+      return false;
+    }
+    content::WebContents* contents = tab->GetContents();
+    if (!contents || !tab->GetURL().SchemeIsHTTPOrHTTPS()) {
+      return false;
+    }
+    const auto page = performance_manager::PerformanceManager::
+        GetPrimaryPageNodeForWebContents(contents);
+    if (!page) {
+      return false;
+    }
+    const auto* live =
+        performance_manager::PageLiveStateDecorator::Data::FromPageNode(
+            page.get());
+    if (!live) {
+      return false;
+    }
+    const base::Time last_active = tab->GetLastActiveTime();
+    if (last_active.is_null()) {
+      return false;
+    }
+    const bool protected_tab =
+        IsDurable(tab, browser) || tab->IsActivated() || tab->IsVisible() ||
+        tab->IsSelected() || tab->IsSplit() || page->IsVisible() ||
+        page->IsOffTheRecord() || !live->IsAutoDiscardable();
+    const bool has_user_edits =
+        page->HadFormInteraction() || page->HadUserEdits() ||
+        contents->NeedToFireBeforeUnloadOrUnloadEvents();
+    const bool has_activity =
+        contents->IsLoading() || contents->IsBeingCaptured() ||
+        contents->GetCurrentlyPlayingVideoCount() > 0 || page->IsAudible() ||
+        page->HasPictureInPicture() || page->UsesWebRTC() ||
+        page->IsHoldingWebLock() || page->IsHoldingBlockingIndexedDBLock() ||
+        live->IsCapturingAudio() || live->IsCapturingVideo() ||
+        live->IsBeingMirrored() || live->IsCapturingWindow() ||
+        live->IsCapturingDisplay() || live->IsDevToolsOpen() ||
+        live->IsConnectedToUSBDevice() ||
+        live->IsConnectedToBluetoothDevice() ||
+        live->IsConnectedToHidDevice() || live->IsConnectedToSerialPort() ||
+        live->IsWithheldFromView() ||
+        page->GetTimeSinceLastNavigation() < base::Hours(hours);
+    return ArciumShouldAutoClean(hours,
+                                 (base::Time::Now() - last_active).InSeconds(),
+                                 protected_tab, has_user_edits, has_activity);
+  }
+
+  void Cleanup() {
+    Browser* browser = GetBrowser();
+    if (!browser || CleanupHours() == 0) {
+      return;
+    }
+    if (browser->profile()->GetPrefs()->GetBoolean(
+            prefs::kSavingBrowserHistoryDisabled)) {
+      return;
+    }
+    const auto self = weak_factory_.GetWeakPtr();
+    const std::string space_id = SpaceId(browser);
+    std::vector<WeakTab> candidates;
+    for (auto* tab : *browser->tab_strip_model()) {
+      if (CanAutoClean(tab, browser, CleanupHours())) {
+        candidates.push_back(tab->GetWeakPtr());
+      }
+      if (candidates.size() >= 8) {
+        break;
+      }
+    }
+    for (const auto& candidate : candidates) {
+      browser = GetBrowser();
+      if (!browser || SpaceId(browser) != space_id || CleanupHours() == 0 ||
+          browser->profile()->GetPrefs()->GetBoolean(
+              prefs::kSavingBrowserHistoryDisabled)) {
+        return;
+      }
+      TabStripModel* model = browser->tab_strip_model();
+      if (!candidate || model->count() <= 1 ||
+          !CanAutoClean(candidate.get(), browser, CleanupHours())) {
+        continue;
+      }
+      const int index = model->GetIndexOfTab(candidate.get());
+      if (index != TabStripModel::kNoTab) {
+        model->CloseWebContentsAt(index,
+                                  TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+        if (!self) {
+          return;
+        }
+      }
+    }
+  }
+
+  bool IsCommandIdChecked(int command_id) const override {
+    return command_id >= kCleanupBase &&
+           command_id - kCleanupBase == CleanupHours();
+  }
+
+  bool IsCommandIdEnabled(int command_id) const override {
+    Browser* browser = GetBrowser();
+    if (!browser) {
+      return false;
+    }
+    if (command_id >= kCleanupBase) {
+      return !browser->profile()->IsOffTheRecord() &&
+             !browser->profile()->GetPrefs()->IsManagedPreference(
+                 arcium_settings::kTabCleanupHoursPref);
+    }
+    return command_id != kRestore ||
+           chrome::IsCommandEnabled(browser_.get(), IDC_RESTORE_TAB);
+  }
+
+  void ExecuteCommand(int command_id, int event_flags) override {
+    if (!IsCommandIdEnabled(command_id)) {
+      return;
+    }
+    if (command_id >= kCleanupBase) {
+      GetBrowser()->profile()->GetPrefs()->SetInteger(
+          arcium_settings::kTabCleanupHoursPref,
+          ArciumCleanupHours(command_id - kCleanupBase));
+    } else if (command_id == kRestore) {
+      chrome::RestoreTab(browser_.get());
+    } else if (command_id == kRecentlyClosed) {
+      chrome::ShowTabSearch(browser_.get());
+    }
+  }
+
+  void ShowMenu() {
+    if (!GetWidget() || (menu_runner_ && menu_runner_->IsRunning())) {
+      return;
+    }
+    menu_will_show_.Run();
+    menu_runner_ = std::make_unique<views::MenuRunner>(
+        &menu_, views::MenuRunner::HAS_MNEMONICS,
+        base::BindRepeating(&ArciumSidebarTabToolsView::OnMenuClosed,
+                            weak_factory_.GetWeakPtr()));
+    menu_runner_->RunMenuAt(
+        GetWidget(), nullptr, menu_button_->GetBoundsInScreen(),
+        views::MenuAnchorPosition::kTopRight, ui::mojom::MenuSourceType::kNone);
+  }
+
+  void OnMenuClosed() { menu_closed_.Run(); }
+
+  base::WeakPtr<BrowserWindowInterface> browser_;
+  base::RepeatingClosure menu_will_show_;
+  base::RepeatingClosure menu_closed_;
+  raw_ptr<views::LabelButton> menu_button_ = nullptr;
+  ui::SimpleMenuModel menu_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+  PrefChangeRegistrar pref_registrar_;
+  base::RepeatingTimer cleanup_timer_;
+  base::WeakPtrFactory<ArciumSidebarTabToolsView> weak_factory_{this};
+};
