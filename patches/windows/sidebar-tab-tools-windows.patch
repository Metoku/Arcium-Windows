+// ARCIUM_TAB_TOOLS_POLICY_BEGIN
+int ArciumCleanupHours(int value) {
+  switch (value) {
+    case 12:
+    case 24:
+    case 72:
+    case 168:
+      return value;
+    default:
+      return 0;
+  }
+}
+
+bool ArciumShouldAutoClean(int hours,
+                           int64_t inactive_seconds,
+                           bool protected_tab,
+                           bool has_user_edits,
+                           bool has_activity) {
+  hours = ArciumCleanupHours(hours);
+  return hours > 0 && inactive_seconds >= int64_t{hours} * 3600 &&
+         !protected_tab && !has_user_edits && !has_activity;
+}
+
+std::vector<std::vector<int>> ArciumTidyBuckets(
+    const std::vector<std::string>& sites) {
+  std::map<std::string, std::vector<int>> by_site;
+  for (size_t i = 0; i < sites.size(); ++i) {
+    if (!sites[i].empty()) {
+      by_site[sites[i]].push_back(static_cast<int>(i));
+    }
+  }
+  std::vector<std::vector<int>> result;
+  for (auto& [site, indices] : by_site) {
+    if (indices.size() >= 2) {
+      result.push_back(std::move(indices));
+    }
+  }
+  return result;
+}
