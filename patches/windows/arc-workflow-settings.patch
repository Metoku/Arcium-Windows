+mojom::BrowserArcShortcutPresetPtr MakeArcPreset(
+    const browser_shortcuts::BrowserShortcutService& service) {
+  auto preset = mojom::BrowserArcShortcutPreset::New();
+#if BUILDFLAG(IS_WIN)
+  preset->can_modify = service.CanModifyConfiguration();
+  preset->has_previous = service.HasPreviousConfiguration();
+  for (const auto& definition : kArcWindowsShortcuts) {
+    auto entry = mojom::BrowserArcShortcutPresetEntry::New();
+    entry->name = GetCommandName(service.GetCommands(), definition.command_id);
+    entry->accelerator = definition.accelerator;
+    auto accelerator = browser_shortcuts::AcceleratorFromString(
+        definition.accelerator);
+    if (!service.HasCommand(definition.command_id)) {
+      entry->reason = "This browser action is unavailable in this build.";
+    } else if (!accelerator || service.IsAcceleratorLocked(
+                                   definition.accelerator,
+                                   definition.command_id)) {
+      entry->reason = "This shortcut is reserved by the browser.";
+    }
+    if (accelerator) {
+      entry->display_text = base::UTF16ToUTF8(
+          browser_shortcuts::AcceleratorToDisplayString(*accelerator));
+    }
+    if (entry->reason.empty()) {
+      preset->supported.push_back(std::move(entry));
+    } else {
+      // A missing command has no localized label; show its key with the reason.
+      if (entry->name.empty()) {
+        entry->name = entry->display_text;
+      }
+      preset->unavailable.push_back(std::move(entry));
+    }
+  }
+#endif
+  return preset;
+}
